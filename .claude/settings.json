{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(argocd *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(bao write *)",
      "Bash(vault write *)",
      "Bash(docker push *)",
      "Bash(npm publish *)",
      "Bash(twine upload *)",
      "Bash(rm -rf *)",
      "Bash(rtk git push *)",
      "Bash(rtk gh pr create *)",
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh release *)",
      "Bash(rtk gh repo *)",
      "Bash(rtk kubectl apply *)",
      "Bash(rtk kubectl delete *)",
      "Bash(rtk kubectl patch *)",
      "Bash(rtk helm install *)",
      "Bash(rtk helm upgrade *)",
      "Bash(rtk helm uninstall *)",
      "Bash(rtk argocd *)",
      "Bash(rtk terraform apply *)",
      "Bash(rtk terraform destroy *)",
      "Bash(rtk tofu apply *)",
      "Bash(rtk tofu destroy *)",
      "Bash(rtk bao write *)",
      "Bash(rtk vault write *)",
      "Bash(rtk docker push *)",
      "Bash(rtk npm publish *)",
      "Bash(rtk twine upload *)",
      "Bash(rtk rm -rf *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.vault-token)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: knowledge graph at graphify-out/. For focused questions, run `graphify query \\\"<question>\\\"` (scoped subgraph, usually much smaller than GRAPH_REPORT.md) instead of grepping raw files. Read GRAPH_REPORT.md only for broad architecture context.\"}}'   || true ;; esac"
          }
        ]
      }
    ]
  }
}
